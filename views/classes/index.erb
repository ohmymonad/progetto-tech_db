<div class="flex items-center justify-between mb-6">
  <h1 class="text-xl font-semibold text-ink-900">Classi</h1>
  <a href="/classes/new" class="text-sm bg-accent-500 hover:bg-accent-600 text-white px-3 py-1.5 rounded">
    Aggiungi classe
  </a>
</div>

<div class="space-y-4">
  <% classes.each do |c| %>
    <div class="border border-ink-200 rounded bg-white px-5 py-4">
      <div class="flex items-start justify-between">
        <div>
          <div class="font-medium text-ink-900"><%= h(c['name']) %></div>
          <div class="text-sm text-ink-600"><%= h(c['schedule']) %> &middot; istruttore <%= h(c['instructor']) %></div>
          <p class="text-sm text-ink-600 mt-1"><%= h(c['description']) %></p>
        </div>
        <div class="text-sm whitespace-nowrap">
          <a href="/classes/<%= c['id'] %>/edit" class="text-accent-600 hover:underline">modifica</a>
          <span class="text-ink-200 mx-1">&middot;</span>
          <form method="post" action="/classes/<%= c['id'] %>/delete" class="inline"
                onsubmit="return confirm('Eliminare questa classe?');">
            <button class="text-ink-400 hover:text-accent-600">elimina</button>
          </form>
        </div>
      </div>

      <div class="mt-3 pt-3 border-t border-ink-100">
        <div class="text-xs text-ink-600 mb-2">Membri iscritti</div>
        <ul class="text-sm flex flex-wrap gap-x-4 gap-y-1">
          <% enrolled_members[c['id']].to_a.each do |m| %>
            <li><%= h(m['last_name']) %> <%= h(m['first_name']) %></li>
          <% end %>
          <% if enrolled_members[c['id']].to_a.empty? %>
            <li class="text-ink-400">nessun membro iscritto</li>
          <% end %>
        </ul>
        <form method="post" action="/classes/<%= c['id'] %>/enroll" class="mt-3 flex gap-2">
          <select name="member_id" required class="border border-ink-200 rounded px-2 py-1 text-sm bg-white">
            <option value="">Iscrivi un membro...</option>
            <% all_members.each do |m| %>
              <option value="<%= m['id'] %>"><%= h(m['last_name']) %> <%= h(m['first_name']) %></option>
            <% end %>
          </select>
          <button class="text-sm border border-ink-200 rounded px-3 py-1 hover:bg-ink-100">Iscrivi</button>
        </form>
      </div>
    </div>
  <% end %>
  <% if classes.empty? %>
    <p class="text-ink-400 text-sm">Nessuna classe disponibile.</p>
  <% end %>
</div>
