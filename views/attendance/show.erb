<a href="/attendance" class="text-sm text-accent-600 hover:underline">&larr; torna alle presenze</a>

<h1 class="text-xl font-semibold text-ink-900 mt-3 mb-6">
  Presenze di <%= h(member['last_name']) %> <%= h(member['first_name']) %>
</h1>

<div class="grid grid-cols-2 gap-4 mb-8 max-w-md">
  <div class="border border-ink-200 rounded px-4 py-3 bg-white">
    <div class="text-xs text-ink-600">Totale visite</div>
    <div class="text-2xl font-semibold text-ink-900"><%= stats['total_visits'] %></div>
  </div>
  <div class="border border-ink-200 rounded px-4 py-3 bg-white">
    <div class="text-xs text-ink-600">Media visite/settimana</div>
    <div class="text-2xl font-semibold text-ink-900"><%= stats['weekly_average'] %></div>
  </div>
</div>

<h2 class="text-sm font-medium text-ink-600 mb-3">Storico presenze</h2>
<table class="w-full text-sm border-collapse max-w-md">
  <tbody>
    <% history.each do |a| %>
      <tr class="border-b border-ink-100">
        <td class="py-2"><%= a['checked_in_at'] %></td>
      </tr>
    <% end %>
    <% if history.empty? %>
      <tr><td class="py-6 text-center text-ink-400">Nessuna presenza registrata.</td></tr>
    <% end %>
  </tbody>
</table>
